# Copy to .env and fill in. Never commit .env.
TELEGRAM_TOKEN=
# Bot username without the @ (shows a "Daily alerts" button on the Workers page)
BOT_USERNAME=
OFFICER_CODE=
ADMIN_TOKEN=
# Assistant model: a free Groq key (console.groq.com) ...
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# ... or, without a Groq key, a local Ollama model
OLLAMA_MODEL=llama3.2:3b
